# ============================================
# .htaccess dla home.pl - GymFuel (MINIMALNA WERSJA)
# ============================================
# 
# Ta wersja zawiera tylko podstawowe ustawienia
# które na pewno działają na home.pl
#
# ============================================

# ============================================
# 1. MOD_REWRITE - Przepisywanie URL
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Przekierowanie z HTTP na HTTPS (odkomentuj gdy masz SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================
# 2. CACHE - Optymalizacja wydajności
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresDefault "access plus 2 days"
</IfModule>

# ============================================
# 3. KOMPRESJA - Zmniejszenie rozmiaru plików
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# 4. BEZPIECZEŃSTWO - Nagłówki HTTP
# ============================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# ============================================
# 5. OCHRONA PLIKÓW - Blokowanie dostępu
# ============================================
# Blokowanie dostępu do plików konfiguracyjnych
<FilesMatch "\.(sql|md|env|git|htaccess|htpasswd|ini|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokowanie plików konfiguracyjnych PHP
<FilesMatch "^(config|database|\.env)\.(php|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================
# 6. USTAWIENIA KATALOGU
# ============================================
Options -Indexes
Options +FollowSymLinks
AddDefaultCharset UTF-8
DirectoryIndex index.php index.html index.htm

# ============================================
# UWAGA: USTAWIENIA PHP ZAKOMENTOWANE
# ============================================
# Na home.pl ustawienia PHP w .htaccess są często zablokowane
# Jeśli potrzebujesz zmienić limity PHP, zrób to przez panel home.pl
# lub plik php.ini (jeśli dostępny)
#
# <IfModule mod_php.c>
#     php_value upload_max_filesize 10M
#     php_value post_max_size 10M
#     php_value max_execution_time 300
#     php_value memory_limit 128M
# </IfModule>

# ============================================
# KONIEC KONFIGURACJI
# ============================================
